{
  "expo": {
    "name": "賺了嗎",
    "slug": "cspo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elaine0326.cspo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "用來選擇券商 app 的持股截圖，辨識後自動填進持股欄位。",
          "cameraPermission": "用來拍下券商 app 的持股畫面，辨識後自動填進持股欄位。",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E3A8A",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "打開 app 時用 Face ID 確認是你本人，保護你的記帳資料。"
        }
      ]
    ],
    "scheme": "stockpnl",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c2ff273c-65d4-48ba-a922-762ee07e82f7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c2ff273c-65d4-48ba-a922-762ee07e82f7"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
