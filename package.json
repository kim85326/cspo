{
  "name": "cspo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "maestro test e2e/",
    "release": "node scripts/release-apk.mjs",
    "ota": "node scripts/ota-update.mjs",
    "backend": "npm --prefix backend install --no-fund --no-audit --silent && npm --prefix backend start",
    "backend:tunnel": "npm --prefix backend install --no-fund --no-audit --silent && npm --prefix backend run tunnel",
    "backend:test": "npm --prefix backend install --no-fund --no-audit --silent && npm --prefix backend run check"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-reanimated",
          "react-native-worklets",
          "react-native-gesture-handler"
        ]
      }
    }
  }
}
