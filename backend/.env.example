# 複製成 backend/.env（已在 .gitignore，不會進 git），填好後執行 npm run backend。

# Anthropic API key：只放在這台電腦，app 拿不到。建議在 Console 開一個專用 workspace 並設每月花費上限。
ANTHROPIC_API_KEY=

# 這個後端提供 AI 解讀（POST /insight，Story 031）與截圖匯入的辨識（POST /recognize，Story 005），
# 兩條共用下面的 key、存取碼、頻率與每日上限。

# 共享存取碼：app 用 Authorization: Bearer <token> 帶過來；沒設的話 /insight、/recognize 一律回 503（fail closed）。
# 產生方式：openssl rand -hex 16
# app 端要在專案根目錄的 .env.local 設同一個值：EXPO_PUBLIC_INSIGHT_ACCESS_TOKEN=...
INSIGHT_ACCESS_TOKEN=

# 以下都有預設值，需要時再改。
# INSIGHT_PORT=8787
# INSIGHT_HOST=0.0.0.0
# 網頁版的來源網址（逗號分隔）；手機 app 不受 CORS 影響。設成 * 代表全部允許；
# https://*.exp.direct 代表 Expo tunnel 網頁版的所有網址。
# INSIGHT_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 每個 IP 每分鐘最多幾次（/insight 與 /recognize 合計）
# INSIGHT_RATE_LIMIT_PER_MINUTE=5
# 整台後端每天最多呼叫 Claude 幾次（/insight 與 /recognize 合計，重啟後重算）
# INSIGHT_DAILY_LIMIT=100
# /insight 的請求內容上限（bytes）
# INSIGHT_MAX_BODY_BYTES=16384
# /recognize 的圖片大小上限（解碼後的 bytes，預設 5 MB，最大 10 MB）；請求內容上限會自動換算成 base64 的長度。
# 圖片格式看檔案內容判斷，只收 JPEG、PNG、WebP、GIF；app 宣告的 mimeType 只能是這幾種或 HEIC。
# INSIGHT_RECOGNIZE_MAX_IMAGE_BYTES=5242880
# 每次回覆的 max_tokens（上限 4096）
# INSIGHT_MAX_TOKENS=2048
# 對外公開請用 npm run backend:tunnel（會自動只聽 127.0.0.1 並開 INSIGHT_TRUST_PROXY=1）。
# 走 ngrok／Cloudflare tunnel 時設 1：從本機轉進來的連線改用 X-Forwarded-For（取最後一個）／CF-Connecting-IP 當來源 IP。
# 只看本機轉進來的連線，直接連進來的人偽造 header 沒有用。
# INSIGHT_TRUST_PROXY=0
# 同時最多幾個請求在等 Claude
# INSIGHT_MAX_CONCURRENT=3
